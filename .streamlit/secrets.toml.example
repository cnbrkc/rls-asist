# Bu dosya ÖRNEKtir. Gerçek secrets.toml oluşturup kendi API anahtarlarınızı ekleyin.
# Veya GitHub Secrets kullanın (ÖNERİLEN).

# GEMINI API ANAHTARLARI (Çoklu anahtar desteği)
[GEMINI_KEYS]
primary = "AIzaSy..._ANAHTARINIZI_BURAYA_YAZIN"
# backup1 = "AIzaSy..._YEDEK_ANAHTAR"
# backup2 = "AIzaSy..._DIGER_YEDEK"

# TELEGRAM AYARLARI
[TELEGRAM]
BOT_TOKEN = "1234567890:ABCdefGHIjklMNOpqrsTUVwxyz"  # BotFather'dan aldığınız token
CHAT_ID = "-1001234567890"  # Mesajların gideceği chat ID (kanal veya özel sohbet)
